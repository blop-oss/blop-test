{
  "name": "@blopai/test",
  "version": "0.1.0",
  "description": "Agent-driven browser E2E tests, local artifacts, and OpenTelemetry reporters for Blop.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent-loop": {
      "types": "./dist/runtime/agent-loop.d.ts",
      "default": "./dist/runtime/agent-loop.js"
    },
    "./config": {
      "types": "./dist/node/config.d.ts",
      "default": "./dist/node/config.js"
    },
    "./coverage": {
      "types": "./dist/coverage.d.ts",
      "default": "./dist/coverage.js"
    },
    "./reporters": {
      "types": "./dist/reporters/index.d.ts",
      "default": "./dist/reporters/index.js"
    },
    "./reporters/*": {
      "types": "./dist/reporters/*.d.ts",
      "default": "./dist/reporters/*.js"
    },
    "./platform": {
      "types": "./dist/platform/upload.d.ts",
      "default": "./dist/platform/upload.js"
    },
    "./otel-config": {
      "types": "./dist/node/otel-config.d.ts",
      "default": "./dist/node/otel-config.js"
    },
    "./templates/basic.blop.ts": "./templates/basic.blop.ts"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "PRIVACY.md",
    "SECURITY.md",
    "RELEASING.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blop-oss/blop-test.git"
  },
  "homepage": "https://github.com/blop-oss/blop-test#readme",
  "bugs": {
    "url": "https://github.com/blop-oss/blop-test/issues"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "format": "prettier --write '*.md' 'bench/*.md' 'test/**/*.md' '.github/**/*.{md,yml,yaml}' 'scripts/**/*.mjs' '*.json' .oxlintrc.json",
    "format:check": "prettier --check '*.md' 'bench/*.md' 'test/**/*.md' '.github/**/*.{md,yml,yaml}' 'scripts/**/*.mjs' '*.json' .oxlintrc.json",
    "check:links": "node scripts/check-markdown-links.mjs",
    "lint": "oxlint src test scripts --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun run test:node && bun run test:e2e && bun run test:vitest",
    "test:node": "bun test test/node",
    "test:e2e": "bun test --max-concurrency=1 test/e2e",
    "test:docker": "bun test --max-concurrency=1 test/e2e/containerized-runner.test.ts",
    "test:vitest": "vitest run --config vitest.config.ts",
    "check:package": "node scripts/check-package.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@blopai/browser-harness": "^0.1.5",
    "@blopai/ingest": "^0.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "playwright": "1.61.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "camoufox-js": "0.11.1",
    "oxlint": "1.78.0",
    "playwright-core": "1.61.1",
    "prettier": "3.9.6",
    "typescript": "^5.8.3",
    "vitest": "3.2.6"
  },
  "peerDependencies": {
    "camoufox-js": "0.11.1",
    "playwright-core": "1.61.1"
  },
  "peerDependenciesMeta": {
    "camoufox-js": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "patchedDependencies": {
    "@blopai/browser-harness@0.1.5": "patches/@blopai__browser-harness@0.1.5.patch"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
